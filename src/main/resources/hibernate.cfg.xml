<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Koneksi (driver, url, user, password) kini berasal dari DataSource di applicationContext.xml -->

        <!-- Dialect untuk MariaDB 10.4 bawaan XAMPP; untuk MySQL 8 ganti MySQL8Dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.MariaDB103Dialect</property>
        <property name="hibernate.dialect.storage_engine">innodb</property>

        <!-- Tabel barang dibuat/diperbarui otomatis dari entity -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Tampilkan SQL buatan Hibernate di jendela Output -->
        <property name="hibernate.show_sql">true</property>

        <mapping class="com.mycompany.mavenproject1.model.Barang"/>
    </session-factory>
</hibernate-configuration>
